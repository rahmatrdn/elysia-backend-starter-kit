{
  "name": "elysia-starter-kit-api",
  "version": "1.0.50",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun run --watch src/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:generate": "drizzle-kit generate && bun scripts/add-sql-comments.ts",
    "db:comment": "bun scripts/add-sql-comments.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:all": "bun run db:generate && bun run db:migrate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@elysiajs/bearer": "^1.4.4",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "drizzle-orm": "^0.45.4",
    "drizzle-typebox": "^0.3.3",
    "elysia": "latest",
    "logixlysia": "^6.10.0",
    "mysql2": "^3.24.5",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0"
  },
  "module": "src/index.js"
}