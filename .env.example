APP_NAME="starter-kit-server-api"
APP_PORT="3010"

NODE_ENV=local

DATABASE_URL=mysql://root:root@localhost:3306/elysia_starter_kit_api

# JWT Authentication Configuration
JWT_SECRET="super-secret-jwt-access-token-key-change-in-production"
